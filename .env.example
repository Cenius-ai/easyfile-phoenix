# EasyFile Environment Configuration
# Copy this file to .env and fill in values for production.

# Required for production — generate with: mix phx.gen.secret
SECRET_KEY_BASE=

# Database URL (optional — defaults to SQLite at priv/repo/easy_file_dev.db)
# DATABASE_URL=ecto://user:pass@localhost/easy_file_dev

# Server port (defaults to 4000)
# PORT=4000

# Host for production URL generation
# PHX_HOST=example.com

# Set to true to start the server in production mode
# PHX_SERVER=true
